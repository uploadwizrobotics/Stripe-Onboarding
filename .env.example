# ---------------------------------------------------------------------------
# Copy this to .env and fill in your key. .env is gitignored.
# ---------------------------------------------------------------------------

# Your Stripe SANDBOX secret key: Dashboard → Developers → API keys.
# Must start with sk_test_ — the app refuses to start on a live key.
#
# Note there's no VITE_ prefix. Vite only compiles VITE_*-prefixed variables
# into the browser bundle, so this key stays in Node and never ships to the
# client. Do not rename it to VITE_STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=sk_test_replace_me

# Currency for products and payment links you create.
STRIPE_CURRENCY=cad

# ---------------------------------------------------------------------------
# Everything below IS compiled into the browser bundle and is public.
# Never put a secret key here.
# ---------------------------------------------------------------------------

# How amounts are displayed. Keep the currency in step with STRIPE_CURRENCY.
VITE_CURRENCY=CAD
VITE_LOCALE=en-CA

# Shows the TEST MODE badge. Keep this true for onboarding.
VITE_TEST_MODE=true
